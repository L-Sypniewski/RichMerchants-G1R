// WITHDRAWN (2026-11-20, user-verified in-game on build 106): the page
// renders and persists (GameUserSettings.ini), but no script-reachable
// path applies the values to initial trader stock — with all three
// sliders set to 5.0 (persisted) a new game still seeded stock at the
// compile-time 3.0 values (Sharky ore 69, arrows 30). A HandleReadyForPlay
// CDO re-base of m_ItemsByDifficulty is too late / ineffective for initial
// stock. Kept for reference; do not enable without a working application
// path. See VALIDATION.md.

// RichMerchants — runtime application of the in-game settings (Settings.as).
//
// WHAT THIS DOES
//   At every world start / save load (HandleReadyForPlay) the stock tables of
//   all vanilla trader config classes (their class-default
//   m_ItemsByDifficulty maps) are re-based to exactly
//   vanillaAmount x settingsMultiplier for ore, arrows and bolts.
//
//   The vanilla amounts come from RichMerchantsStock.as itself: the seed
//   override captures every stock entry in its vanilla (pre-multiplier) form
//   into UTraderConfigBase.m_VanillaStock while the trader classes register —
//   so this file needs no baked tables and stays exact across game updates.
//   Every entry is SET to an absolute value (RoundToInt(RoundToInt(base x
//   difficultyMult) x setting)); nothing is ever multiplied on top of previous
//   writes, making the re-base idempotent. With default settings (3.0) the
//   re-based values are bit-identical to the compile-time seed.
//
// WHEN CHANGES APPLY
//   A changed multiplier applies to stock generated after the next world
//   load: new games and chapter-transition restocks (which is also how an
//   EXISTING save picks it up — trader stock is serialized inside the save;
//   see the README's "existing saves" section). The accumulated stock of a
//   running save is not re-based (live trader state is native and not
//   script-reachable).
//
// ENGINE NOTES (build 106)
//   - Only `Value` is bound on FModUserSettingsFloat (no DisplayText/Min/
//     Max), so rows render with engine-default labels; values are clamped
//     to [0, 100] here instead.
//   - UClass::GetAllSubclassesOf / TSubclassOf .Get().DefaultObject /
//     TMap Contains / [key] / .Add(key, value) are shipped-script idioms.

class URichMerchantsSubsystem : UGothicModExt_WorldSubsystem
{
    UFUNCTION(BlueprintOverride)
    void HandleReadyForPlay()
    {
        float OreMult = GetClampedMultiplier(0);
        float ArrowMult = GetClampedMultiplier(1);
        float BoltMult = GetClampedMultiplier(2);

        for (UClass TraderClass : UClass::GetAllSubclassesOf(UTraderConfigBase::StaticClass()))
        {
            UTraderConfigBase TraderCdo = Cast<UTraderConfigBase>(TraderClass.GetDefaultObject());
            if (TraderCdo == nullptr)
                continue;
            for (FRichMerchantsCapturedStock Entry : TraderCdo.m_VanillaStock)
            {
                float Mult = OreMult;
                if (Entry.ItemId == 1)
                    Mult = ArrowMult;
                else if (Entry.ItemId == 2)
                    Mult = BoltMult;

                TSubclassOf<UItemDefinition> ItemClass = UItMi_Orenugget::StaticClass();
                if (Entry.ItemId == 1)
                    ItemClass = UItAm_Arrow::StaticClass();
                else if (Entry.ItemId == 2)
                    ItemClass = UItAm_Bolt::StaticClass();

                int Category = TraderCdo.GetCategoryForItem(ItemClass);
                RebaseDifficulty(TraderCdo, UResourcesDifficultySettings_Easy::StaticClass(), Entry, ItemClass, Category, Mult);
                RebaseDifficulty(TraderCdo, UResourcesDifficultySettings_Standard::StaticClass(), Entry, ItemClass, Category, Mult);
                RebaseDifficulty(TraderCdo, UResourcesDifficultySettings_Hard::StaticClass(), Entry, ItemClass, Category, Mult);
            }
        }
    }

    float GetClampedMultiplier(int itemId)
    {
        URichMerchantsUserSettings Settings = URichMerchantsUserSettings.DefaultObject;
        float Value = 1.0f;
        if (Settings != nullptr)
        {
            if (itemId == 0)
                Value = Settings.OreMultiplier.Value;
            else if (itemId == 1)
                Value = Settings.ArrowMultiplier.Value;
            else
                Value = Settings.BoltMultiplier.Value;
        }
        if (Value < 0.0f)
            Value = 0.0f;
        if (Value > 100.0f)
            Value = 100.0f;
        return Value;
    }

    // Sets the CDO entry [difficulty][event].m_Items[item] to
    // RoundToInt(RoundToInt(BaseCount x difficultyCategoryMult) x Mult) —
    // the same arithmetic as the compile-time seed, so both mechanisms agree
    // bit-for-bit at equal multipliers.
    void RebaseDifficulty(
        UTraderConfigBase TraderCdo,
        TSubclassOf<UDifficultySettings> DifficultyClass,
        FRichMerchantsCapturedStock Entry,
        TSubclassOf<UItemDefinition> ItemClass,
        int Category,
        float Mult)
    {
        if (!TraderCdo.m_ItemsByDifficulty.Contains(DifficultyClass))
            return;
        FInventoryByChapter ChapterMap = TraderCdo.m_ItemsByDifficulty[DifficultyClass];
        if (!ChapterMap.m_ItemsByChapter.Contains(Entry.Event))
            return;
        FTraderInventoryMap InventoryMap = ChapterMap.m_ItemsByChapter[Entry.Event];
        if (!InventoryMap.m_Items.Contains(ItemClass))
            return;

        float DifficultyMult = TraderCdo.GetTraderCategoryMultiplier(DifficultyClass, Category);
        int Target = TraderCdo.RoundToInt(float(TraderCdo.RoundToInt(float(Entry.BaseCount) * DifficultyMult)) * Mult);

        if (InventoryMap.m_Items[ItemClass] == Target)
            return; // idempotent no-op (default settings on a freshly seeded CDO)

        InventoryMap.m_Items.Add(ItemClass, Target);
        ChapterMap.m_ItemsByChapter.Add(Entry.Event, InventoryMap);
        TraderCdo.m_ItemsByDifficulty.Add(DifficultyClass, ChapterMap);
    }
}
